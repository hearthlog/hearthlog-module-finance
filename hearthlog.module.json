{
  "manifestVersion": 1,
  "id": "org.stor.finance",
  "package": "@hearthlog/module-finance",
  "version": "1.7.0",
  "compatibility": {
    "moduleApi": 1
  },
  "features": [
    {
      "id": "finance",
      "path": "/finance",
      "label": "Finance",
      "subtitle": "Cash-flow runway, linked accounts, and recurring budgets",
      "keywords": "money transactions forecast assets wallet cash flow recurring",
      "navGroup": "Money",
      "icon": "chart-line",
      "navOrder": 10,
      "mobilePrimary": true,
      "mobileOrder": 2,
      "children": [
        {
          "id": "transactions",
          "label": "Cash Flow",
          "href": "/finance",
          "tab": null
        },
        {
          "id": "budget",
          "label": "Budget & Recurring",
          "href": "/finance?tab=budget",
          "tab": "budget"
        }
      ],
      "shortcuts": [
        {
          "id": "add-transaction",
          "label": "Add transaction",
          "subtitle": "Open the Finance transaction drawer",
          "keywords": "new transaction income expense money",
          "query": "?newTransaction=1"
        }
      ]
    }
  ],
  "layouts": [
    {
      "path": "/finance",
      "page": "./src/pages/layout.svelte",
      "load": "./src/pages/layout.ts"
    }
  ],
  "routes": [
    {
      "path": "/finance",
      "page": "./src/pages/index.svelte",
      "load": "./src/pages/index.ts",
      "fitsScreen": true,
      "resolvesTo": "/finance/[year]/[month]"
    },
    {
      "path": "/finance/[year]/[month]",
      "page": "./src/pages/month.svelte",
      "load": "./src/pages/month.ts",
      "fitsScreen": true,
      "keepMounted": true
    }
  ],
  "calendarIcons": [
    "cash-clock"
  ],
  "data": {
    "definitions": "./src/data/definitions.ts",
    "repositories": "./src/data/repositories.ts"
  },
  "projectionVersion": 2,
  "aiCapabilities": [
    "category-pick"
  ],
  "attention": "./src/attention.ts",
  "server": {
    "entry": "./src/server/index.ts",
    "routes": [
      "/api/finance/bank"
    ],
    "bindings": [
      {
        "binding": "FINANCE_BANK_STATE",
        "type": "durable-object",
        "className": "FinanceBankState"
      }
    ],
    "vars": [
      {
        "name": "FINANCE_MAIL_DOMAIN",
        "setting": "mailDomain",
        "optional": true
      }
    ],
    "hourly": true,
    "secrets": [
      {
        "name": "FINANCE_EB_APP_ID",
        "optional": true
      },
      {
        "name": "FINANCE_EB_PRIVATE_KEY",
        "optional": true
      }
    ]
  },
  "refreshKeys": [
    "app:transactions",
    "app:assets",
    "app:budgets"
  ],
  "styles": "./src/styles.css",
  "integrationKinds": [
    {
      "kind": "bank-email",
      "feature": "finance"
    },
    {
      "kind": "bank-approval",
      "feature": "finance"
    }
  ]
}
